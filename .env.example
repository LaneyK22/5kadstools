# Path to a local 5k-os clone. Defaults to ../5k-os next to this repo.
FIVEK_OS_PATH=

# Path to the Claude Code CLI, if `claude` isn't on PATH.
CLAUDE_BIN=

# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_PASSWORD=

# Google OAuth client ("Web application") for 5k.co sign-in.
# Leave empty in local dev to use the dev sign-in buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL, e.g. https://ads.5k.co. Defaults to the request's origin.
APP_URL=
